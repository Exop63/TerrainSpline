#pragma kernel CSApplyPathHeight
#pragma kernel CSApplyShapeHeight

struct GPUSplineSample
{
    float3 position;
    float4 rotation; // Quaternion (x, y, z, w)
    float3 scale;
};

// Buffers
RWStructuredBuffer<float> Heights;
StructuredBuffer<GPUSplineSample> Samples;

// Uniforms
uint Width;
uint Height;
uint MinX;
uint MinZ;
uint HeightmapRes;
float3 TerrainPos;
float3 TerrainSize;
float BaseBrushRadius;
float BrushHardness;
float BrushStrength;
float HeightOffset;
uint SampleCount;

// Helpers
float3 RotateVector(float3 v, float4 q)
{
    return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v);
}

float CalculateFalloff(float dist, float radius, float hardness)
{
    if (dist >= radius) return 0.0;
    float t = dist / radius;
    float falloff = 0.0;
    if (t < hardness)
    {
        falloff = 1.0;
    }
    else
    {
        float denom = 1.0 - hardness;
        if (denom > 0.0001)
        {
            float norm = (t - hardness) / denom;
            falloff = 1.0 - norm * norm * (3.0 - 2.0 * norm);
        }
    }
    return falloff;
}

[numthreads(8, 8, 1)]
void CSApplyPathHeight(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= Width || id.y >= Height)
        return;

    uint localX = id.x;
    uint localZ = id.y;
    uint globalX = MinX + localX;
    uint globalZ = MinZ + localZ;

    float worldX = ((float)globalX / (float)(HeightmapRes - 1)) * TerrainSize.x + TerrainPos.x;
    float worldZ = ((float)globalZ / (float)(HeightmapRes - 1)) * TerrainSize.z + TerrainPos.z;

    float totalWeight = 0.0;
    float blendedTargetHeight = 0.0;
    float maxStrength = 0.0;

    for (uint i = 0; i < SampleCount; i++)
    {
        GPUSplineSample s = Samples[i];
        float dx = worldX - s.position.x;
        float dz = worldZ - s.position.z;
        float distSq = dx * dx + dz * dz;

        float scaledRadius = BaseBrushRadius * s.scale.x;
        float scaledRadiusSq = scaledRadius * scaledRadius;

        if (distSq > scaledRadiusSq || scaledRadiusSq <= 0.0001) continue;

        float dist = sqrt(distSq);
        float falloff = CalculateFalloff(dist, scaledRadius, BrushHardness);
        float strength = falloff * BrushStrength;

        if (strength > maxStrength) maxStrength = strength;

        // Rotate Vector3.up (0,1,0) by quaternion
        float3 up = RotateVector(float3(0, 1, 0), s.rotation);
        float planeY = s.position.y;
        if (abs(up.y) > 0.001)
        {
            planeY = s.position.y - (up.x * dx + up.z * dz) / up.y;
        }

        float targetHeight = (planeY + HeightOffset - TerrainPos.y) / TerrainSize.y;

        // Smooth blending weight (1 at center, 0 at edge)
        float w = 1.0 - (dist / scaledRadius);
        w = w * w * w; // Cubic falloff

        blendedTargetHeight += targetHeight * w;
        totalWeight += w;
    }

    uint index = localZ * Width + localX;
    if (totalWeight > 0.0)
    {
        blendedTargetHeight /= totalWeight;
        Heights[index] = lerp(Heights[index], blendedTargetHeight, maxStrength);
    }
}

// Shape Mode Uniforms & Buffers
StructuredBuffer<float2> PolygonPoints;
uint PolygonPointCount;
float ShapeEdgeFalloff;
float ShapeFillHeight;
uint ShapeUseSplineHeight;
StructuredBuffer<float3> SplineSamples; // positions only
uint SplineSampleCount;

bool IsPointInPolygon(float2 p, StructuredBuffer<float2> poly, uint count)
{
    bool inside = false;
    for (uint i = 0, j = count - 1; i < count; j = i++)
    {
        if (((poly[i].y > p.y) != (poly[j].y > p.y)) &&
            (p.x < (poly[j].x - poly[i].x) * (p.y - poly[i].y) / (poly[j].y - poly[i].y + 1e-9) + poly[i].x))
        {
            inside = !inside;
        }
    }
    return inside;
}

float DistanceToPolygonEdge(float2 p, StructuredBuffer<float2> poly, uint count)
{
    float minDist = 1e9;
    for (uint i = 0, j = count - 1; i < count; j = i++)
    {
        float2 v = poly[i];
        float2 w = poly[j];
        
        float l2 = dot(v - w, v - w);
        if (l2 < 1e-9)
        {
            minDist = min(minDist, distance(p, v));
            continue;
        }

        float t = max(0.0, min(1.0, dot(p - v, w - v) / l2));
        float2 projection = v + t * (w - v);
        minDist = min(minDist, distance(p, projection));
    }
    return minDist;
}



float GetSmoothIDWHeight(StructuredBuffer<float3> samples, uint count, float worldX, float worldZ)
{
    float sumWeight = 0.0;
    float sumHeight = 0.0;
    float2 p = float2(worldX, worldZ);

    for (uint i = 0; i < count; i++)
    {
        float2 v = samples[i].xz;
        float2 diff = p - v;
        float distSq = dot(diff, diff);

        if (distSq < 0.0001)
        {
            return samples[i].y;
        }

        // Inverse Distance Weighting (power = 4)
        float weight = 1.0 / (distSq * distSq);
        sumWeight += weight;
        sumHeight += samples[i].y * weight;
    }

    return sumWeight > 0.0 ? sumHeight / sumWeight : 0.0;
}

[numthreads(8, 8, 1)]
void CSApplyShapeHeight(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= Width || id.y >= Height)
        return;

    uint localX = id.x;
    uint localZ = id.y;
    uint globalX = MinX + localX;
    uint globalZ = MinZ + localZ;

    float worldX = ((float)globalX / (float)(HeightmapRes - 1)) * TerrainSize.x + TerrainPos.x;
    float worldZ = ((float)globalZ / (float)(HeightmapRes - 1)) * TerrainSize.z + TerrainPos.z;
    float2 pointXZ = float2(worldX, worldZ);

    bool isInside = IsPointInPolygon(pointXZ, PolygonPoints, PolygonPointCount);
    float edgeDist = DistanceToPolygonEdge(pointXZ, PolygonPoints, PolygonPointCount);

    float sd = isInside ? edgeDist : -edgeDist;
    float strength = 1.0;

    if (ShapeEdgeFalloff > 0.001)
    {
        float t = (sd + ShapeEdgeFalloff) / (2.0 * ShapeEdgeFalloff);
        t = clamp(t, 0.0, 1.0);
        strength = t * t * (3.0 - 2.0 * t);
    }
    else
    {
        strength = isInside ? 1.0 : 0.0;
    }

    if (strength <= 0.001) return;

    strength *= BrushStrength;

    float targetHeight = 0.0;
    if (ShapeUseSplineHeight > 0)
    {
        float closestHeight = GetSmoothIDWHeight(SplineSamples, SplineSampleCount, worldX, worldZ);
        targetHeight = (closestHeight + HeightOffset - TerrainPos.y) / TerrainSize.y;
    }
    else
    {
        targetHeight = (ShapeFillHeight + HeightOffset - TerrainPos.y) / TerrainSize.y;
    }

    uint index = localZ * Width + localX;
    Heights[index] = lerp(Heights[index], targetHeight, strength);
}
